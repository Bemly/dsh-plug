{
  "name": "dsh-opencode-presets",
  "version": "1.0.3",
  "description": "One plugin, two agent presets ported from Bemly/opencode: nsfw (adult-fiction executor) and unrestricted (security-research executor).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "opencode"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.webp"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.webp",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bemly/dsh-plug.git",
    "directory": "bundles/opencode-presets"
  },
  "homepage": "https://github.com/Bemly/dsh-plug/tree/main/bundles/opencode-presets",
  "bugs": {
    "url": "https://github.com/Bemly/dsh-plug/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.0 <4.1.0 || >=4.0.5-0 <5.0.0-0",
    "@deepseek-ai/dsh-agent-preset": ">=0.1.7-0 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.0 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-0 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    }
  },
  "dsh-plugin": {
    "category": "identity",
    "displayName": "OpenCode Presets（NSFW + Unrestricted）"
  }
}
