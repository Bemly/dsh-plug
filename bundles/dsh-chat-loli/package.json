{
  "name": "dsh-chat-loli",
  "version": "1.0.0",
  "description": "DSH agent preset 「鲸鱼娘捆绑模式」：鲸鱼娘人设 + 仅 web_search / web_fetch，无 shell、无文件读写、无 glob/grep、无记忆写入（persona 来自 dsh-whale-loli，MIT）。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "chat",
    "persona"
  ],
  "exports": {
    "./icon": "./icon.webp"
  },
  "files": [
    "cordis.patch.yml",
    "icon.webp",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bemly/dsh-plug.git",
    "directory": "bundles/dsh-chat-loli"
  },
  "homepage": "https://github.com/Bemly/dsh-plug/tree/main/bundles/dsh-chat-loli",
  "bugs": {
    "url": "https://github.com/Bemly/dsh-plug/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.0 <4.1.0 || >=4.0.5-0 <5.0.0-0",
    "@deepseek-ai/dsh-agent-preset": ">=0.1.7-0 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.0 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-0 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    }
  },
  "dsh-plugin": {
    "category": "identity",
    "displayName": "鲸鱼娘捆绑模式"
  }
}
