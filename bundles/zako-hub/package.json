{
  "name": "dsh-zako-hub",
  "version": "1.0.3",
  "type": "module",
  "description": "Encrypted-payload installer bundle for DSH: decrypts the bundled payload and installs it into the current profile.",
  "bin": {
    "zako-hub": "./bin/cli.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "payload/dsh-zako-hub.tar.zstd",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "fzstd": "^0.1.1",
    "tar": "^7.5.22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bemly/dsh-plug.git",
    "directory": "bundles/zako-hub"
  },
  "homepage": "https://github.com/Bemly/dsh-plug/tree/main/bundles/zako-hub"
}
