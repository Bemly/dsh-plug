{
  "name": "magpie-image-slim",
  "version": "0.1.4",
  "description": "Magpie gateway middleware: slim historical inline images into the STANDARD image-slim placeholder (agy-bridge only masks that format, so the session is not rebuilt), keeping the DSH local path inside the placeholder.",
  "license": "MIT",
  "type": "module",
  "files": [
    "image-slim.middleware.js",
    "icon.png"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "magpie-plugin",
    "image-slim",
    "dsh",
    "cache"
  ],
  "magpie": {
    "middleware": "./image-slim.middleware.js",
    "icon": "https://raw.githubusercontent.com/Bemly/dsh-plug/main/magpie/middlewares/magpie-image-slim/icon.png",
    "options": {
      "agents": [
        "dsh"
      ],
      "models": [],
      "keepCurrentTurn": true,
      "replaceImages": true,
      "splitPlaceholders": false,
      "log": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bemly/dsh-plug.git",
    "directory": "magpie/middlewares/magpie-image-slim"
  }
}
